{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Sid":  "BedrockInference",
                          "Resource":  "*",
                          "Action":  [
                                         "bedrock:InvokeModel",
                                         "bedrock:InvokeModelWithResponseStream"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "FrozenS3Artifacts",
                          "Resource":  "arn:aws:s3:::obesity-ci-copilot-353708126804-us-east-1/obesity-ci-copilot/v3/*",
                          "Action":  [
                                         "s3:GetObject",
                                         "s3:GetObjectVersion"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "ListProjectBucket",
                          "Resource":  "arn:aws:s3:::obesity-ci-copilot-353708126804-us-east-1",
                          "Action":  "s3:ListBucket"
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "GlueRead",
                          "Resource":  "*",
                          "Action":  [
                                         "glue:GetDatabase",
                                         "glue:GetDatabases",
                                         "glue:GetTable",
                                         "glue:GetTables",
                                         "glue:GetPartitions"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "AthenaExecution",
                          "Resource":  "*",
                          "Action":  [
                                         "athena:StartQueryExecution",
                                         "athena:GetQueryExecution",
                                         "athena:GetQueryResults",
                                         "athena:StopQueryExecution",
                                         "athena:GetWorkGroup"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "AthenaResults",
                          "Resource":  [
                                           "arn:aws:s3:::obesity-ci-copilot-353708126804-us-east-1",
                                           "arn:aws:s3:::obesity-ci-copilot-353708126804-us-east-1/obesity-ci-copilot/v3/athena-results/*"
                                       ],
                          "Action":  [
                                         "s3:GetBucketLocation",
                                         "s3:GetObject",
                                         "s3:PutObject"
                                     ]
                      }
                  ]
}